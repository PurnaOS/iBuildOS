---
import Layout from "../layouts/Layout.astro";
---

<Layout title="iBuildOS static-site template">
  <h1 class="text-4xl font-bold text-white">Your new static site</h1>
  <p class="mt-4 text-lg text-slate-300">
    This homepage is a real, minimal Astro page. Tailwind utility classes
    style this text and the layout around it — edit
    <code class="rounded bg-slate-800 px-1.5 py-0.5 text-sm text-sky-300">
      src/pages/index.astro
    </code>
    to make it yours.
  </p>
  <a
    href="/posts/hello-world/"
    class="mt-8 inline-block rounded-md bg-sky-500 px-4 py-2 font-medium text-slate-950 transition hover:bg-sky-400"
  >
    Read the first post
  </a>
</Layout>
