# dependencies
node_modules/

# lockfile: not committed. This directory is generated *inside* the
# iBuildOS monorepo (which has its own pnpm-workspace.yaml above it), so a
# lockfile produced here (even with --ignore-workspace) doesn't reliably
# reflect what a scaffolded project's own `pnpm install` — a different
# pnpm major, no parent workspace file — will resolve. package.json's
# ranges are the source of truth for a fresh scaffold.
pnpm-lock.yaml

# auto-generated by `next dev`/`next build` (Next.js 16 agent-rules
# feature); regenerates on first run, not template source.
AGENTS.md
CLAUDE.md

# next.js build output
.next/
out/

# local sqlite database files (created by db:migrate / db:seed / dev)
*.db
*.db-wal
*.db-journal
*.db-shm

# env
.env
.env*.local

